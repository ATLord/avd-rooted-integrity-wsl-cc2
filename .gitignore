# Kernel build artifacts (regenerated by kernel-build/scripts/*)
# ============================================================================
kernel-build/sources/
kernel-build/out/
kernel-build/.ccache/
kernel-build/patches/
kernel-build/docs/
*.log

# Prebuilt / large binaries — this repo is source + scripts only.
*.img
*.img.gz
Image
Image.gz
*.tar.gz
*.zip
*.apk
*.so
*.dex

# Local x86 build inputs, kernel outputs and credentials.
x86/out/
x86/cache/
x86/keybox.xml
x86/downloads/
x86/xserver/
__pycache__/
*.pyc
/.ccache/

# ============================================================================
